# Managed by ansible/roles/monitoring_server — targets come from the
# inventory (hosts.yml, generated by terraform). Every target is a private
# IP; the other cloud is reached through the bastions' WireGuard tunnel.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    chain_id: {{ chain_id }}

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:{{ alertmanager_port }}"]

scrape_configs:
{% for group in ['validators', 'sentries', 'rpc', 'archive'] %}
  - job_name: konstellation-{{ group }}
    static_configs:
{% for host in groups[group] | default([]) %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['prometheus_port'] | default(26660) }}"]
        labels:
          instance: {{ host }}
          role: {{ hostvars[host]['node_role'] | default(group) }}
          cloud: {{ hostvars[host]['cloud'] | default('') }}
{% endfor %}
{% endfor %}

  - job_name: node-exporter
    static_configs:
{% for host in groups['all'] %}
{% if host != inventory_hostname %}
{# an entry bastion's ansible_host is its public IP; scrape its private one #}
      - targets: ["{{ hostvars[host]['private_ip'] | default(hostvars[host]['ansible_host']) }}:{{ hostvars[host]['node_exporter_port'] | default(9100) }}"]
        labels:
          instance: {{ host }}
          role: {{ hostvars[host]['node_role'] | default('') }}
          cloud: {{ hostvars[host]['cloud'] | default('') }}
{% endif %}
{% endfor %}
      - targets: ["127.0.0.1:{{ node_exporter_port | default(9100) }}"]
        labels:
          instance: {{ inventory_hostname }}
          role: monitoring

{% if groups['cosigners'] | default([]) | length > 0 %}
  # horcrux cosigners (dedicated mode): one instance per validator per host,
  # debugAddr ports base+i (roles/horcrux). A cosigner that stops answering
  # here is a shard out of the 2-of-3 cluster.
  - job_name: horcrux
    static_configs:
{% for host in groups['cosigners'] %}
{% for v in groups['validators'] | sort %}
      - targets: ["{{ hostvars[host]['ansible_host'] }}:{{ (hostvars[host]['horcrux_debug_base_port'] | default(8453)) + loop.index0 }}"]
        labels:
          instance: {{ host }}
          validator: {{ v }}
          cloud: {{ hostvars[host]['cloud'] | default('') }}
{% endfor %}
{% endfor %}
{% endif %}

  # tenderduty's own metrics: missed blocks per validator as the pager sees
  # them, and `up` on this job is "the pager is alive".
  - job_name: tenderduty
    static_configs:
      - targets: ["127.0.0.1:{{ tenderduty_prometheus_port }}"]
        labels:
          instance: tenderduty

  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_web_port }}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:{{ alertmanager_port }}"]
