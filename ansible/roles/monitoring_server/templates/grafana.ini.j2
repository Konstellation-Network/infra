# Managed by ansible/roles/monitoring_server. Loopback only: reach it with
#   ssh -F ansible/inventories/testnet-1/ssh_config -L 3000:{{ ansible_host }}:3000 {{ inventory_hostname }}
# then http://localhost:3000. No public exposure, no anonymous access.
[server]
http_addr = 127.0.0.1
http_port = {{ grafana_port }}

[paths]
data = {{ monitoring_data_dir }}/grafana

[security]
# Change on first login; the admin password is not managed by ansible.
admin_user = admin
disable_gravatar = true
cookie_secure = false

[users]
allow_sign_up = false
allow_org_create = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
