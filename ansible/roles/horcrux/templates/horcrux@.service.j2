[Unit]
Description=Konstellation horcrux threshold cosigner (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ konstellation_user }}
Group={{ konstellation_group }}
# v3: `start` is a root command and --home a root flag (v2 had `cosigner start`).
ExecStart=/usr/local/bin/horcrux --home {{ horcrux_home }}/%i start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
