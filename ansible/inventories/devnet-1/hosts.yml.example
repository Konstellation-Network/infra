---
# devnet-1 on Contabo (founder decision, 2026-09-30): three VPSes ordered BY
# HAND in Contabo's panel. There is no OpenTofu for devnet-1, so nothing
# generates this file — copy it to hosts.yml (and ssh_config.example to
# ssh_config) and fill in the four FILL IN values below. Everything else is
# derived from them. The addresses here are RFC 5737 documentation IPs.
#
#   server 1  validator        plain priv_validator_key.json (no Horcrux);
#                              SSH and p2p from server 2 only; RPC on loopback
#   server 2  sentry + rpc     the only public endpoint: p2p, CometBFT RPC,
#             + SSH entry      REST, EVM JSON-RPC/WS; operators SSH here and
#                              ProxyJump on to servers 1 and 3 (ssh_config)
#   server 3  archive          pruning=nothing + tracing, RPC on loopback;
#             + monitoring     prometheus/alertmanager/grafana/tenderduty
#                              (explorer + faucet containers later)
#
# Each VPS has one public IPv4 and one disk. No private network, no cloud
# firewall, no separate volume: ansible/roles/firewall (ufw) is the only
# network control, so every "internal" source below is an exact public /32
# (roles/firewall asserts it: private_network is false in group_vars/all.yml).
#
# Multi-role hosts: a host is listed in every group whose role it holds and
# roles/firewall applies the union of their rules. node_role is pinned per
# host, because with several groups the group_vars value would otherwise be
# whichever file sorts last. See README "devnet-1".
all:
  vars:
    ansible_user: deploy
    # Server 2 is reached directly; servers 1 and 3 by ProxyJump through it
    # (ssh_config next to this file). Humans: `ssh -F ssh_config <host>`.
    ansible_ssh_common_args: "-F {{ inventory_dir }}/ssh_config"
    chain_id: devnet-1

    # ---- FILL IN: the three public IPv4s from the Contabo panel ----------
    devnet_validator_ip: 192.0.2.11      # server 1
    devnet_sentry_ip: 198.51.100.21      # server 2
    devnet_archive_ip: 203.0.113.31      # server 3
    # ---- FILL IN: where you SSH from (server 2 admits only these) --------
    # Specific /32s (or your ISP's narrowest stable range). Never 0.0.0.0/0 —
    # roles/firewall refuses it. A dynamic home IP that changes locks you
    # out until you fix it through Contabo's VNC console (root password).
    devnet_operator_ssh_cidrs:
      - 192.0.2.250/32
    # -----------------------------------------------------------------------

    # Derived — do not edit below unless the shape changes.
    # All three hosts; kept for asserts and anything that means "the fleet".
    fleet_cidrs:
      - "{{ devnet_validator_ip }}/32"
      - "{{ devnet_sentry_ip }}/32"
      - "{{ devnet_archive_ip }}/32"
    # Metrics (9100, 26660) are scraped by server 3 only; nobody else,
    # including server 2, may read them.
    metrics_scrape_cidrs:
      - "{{ devnet_archive_ip }}/32"
    # The SSH source for servers 1 and 3 = server 2's PUBLIC address (the
    # variable name comes from the private-network fleets; see
    # roles/firewall/defaults).
    bastion_private_ip: "{{ devnet_sentry_ip }}"
    ssh_entry_bastion_private_ip: ""
    # Monitoring host = server 3's public address (tenderduty -> server 2's
    # 26657; archive 26657 admits it).
    monitoring_host_private_ip: "{{ devnet_archive_ip }}"
  children:
    chain_nodes:
      children:
        validators:
        sentries:
        rpc:
        archive:
    validators:
      hosts:
        devnet-1-contabo-validator-v1:
    sentries:
      hosts:
        devnet-1-contabo-sentry-rpc-1:
    rpc:
      hosts:
        devnet-1-contabo-sentry-rpc-1:
    archive:
      hosts:
        devnet-1-contabo-archive-mon-1:
    bastions:
      hosts:
        devnet-1-contabo-sentry-rpc-1:
    monitoring:
      hosts:
        devnet-1-contabo-archive-mon-1:
    cosigners:
      hosts:

# Per-host facts, in one place per host. (YAML inventories merge a host's
# vars from every group it is listed in; keeping them under `ungrouped`
# would move the host out of its groups, so they go under `all.hosts`.)
  hosts:
    # server 1
    devnet-1-contabo-validator-v1:
      ansible_host: "{{ devnet_validator_ip }}"
      public_ipv4: "{{ devnet_validator_ip }}"
      moniker: devnet-1-contabo-validator-v1
      node_role: validator
    # server 2
    devnet-1-contabo-sentry-rpc-1:
      ansible_host: "{{ devnet_sentry_ip }}"
      public_ipv4: "{{ devnet_sentry_ip }}"
      moniker: devnet-1-contabo-sentry-rpc-1
      # one konstellationd serving both roles: sentry peering (validator in
      # private_peer_ids) from group_vars/sentries.yml, public RPC listeners
      # and the mempool floor from group_vars/rpc.yml; firewall = union of
      # sentry, rpc and bastion rules.
      node_role: sentry
      # bastion role: the SSH entry point. No NAT, no tunnel, no forwarding.
      ssh_entry: true
      operator_ssh_cidrs: "{{ devnet_operator_ssh_cidrs }}"
      nat_gateway: false
      remote_cidrs: []
    # server 3
    devnet-1-contabo-archive-mon-1:
      ansible_host: "{{ devnet_archive_ip }}"
      public_ipv4: "{{ devnet_archive_ip }}"
      moniker: devnet-1-contabo-archive-mon-1
      node_role: archive
