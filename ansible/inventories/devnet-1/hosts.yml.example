---
# This file is generated by `terraform apply` in terraform/envs/devnet-1
# (see outputs.tf's local_file.ansible_inventory) into hosts.yml — do not hand
# edit hosts.yml, it will be overwritten on the next apply. A matching
# ssh_config (ProxyJump through the bastion) is generated next to it. This
# .example shows the expected shape before any infrastructure exists, with
# the defaults: one validator (D18), sentry_count = 1, everything on Hetzner
# in one location, no Horcrux, no WireGuard tunnel. Public IPs are
# documentation addresses (RFC 5737).
all:
  vars:
    ansible_user: deploy
    # Every connection goes through the bastion — see ssh_config next to this
    # file (also generated by terraform). Humans: `ssh -F ssh_config <host>`.
    ansible_ssh_common_args: "-F {{ inventory_dir }}/ssh_config"
    chain_id: devnet-1
    fleet_cidrs:
      - 10.0.3.0/24
    # single entry point = the only bastion, same cloud: nothing extra
    ssh_entry_bastion_private_ip: ""
    monitoring_host_private_ip: 10.0.3.50
    # One validator signing with its own priv_validator_key.json: no Horcrux
    # hosts or instances (README "devnet-1"). site.yml skips both horcrux plays.
    horcrux_mode: none
    # One cloud: no site-to-site WireGuard tunnel (site.yml skips roles/wireguard).
    cross_cloud_tunnel: false
  children:
    chain_nodes:
      children:
        validators:
        sentries:
        rpc:
        archive:
    validators:
      hosts:
        devnet-1-hetzner-validator-v1:
          ansible_host: 10.0.3.11
          moniker: devnet-1-hetzner-validator-v1
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          bastion_private_ip: 10.0.3.5
    sentries:
      hosts:
        devnet-1-hetzner-sentry-1:
          ansible_host: 10.0.3.21
          public_ipv4: 203.0.113.21
          moniker: devnet-1-hetzner-sentry-1
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          bastion_private_ip: 10.0.3.5
    rpc:
      hosts:
        devnet-1-hetzner-rpc-1:
          ansible_host: 10.0.3.31
          public_ipv4: 203.0.113.31
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          bastion_private_ip: 10.0.3.5
    archive:
      hosts:
        devnet-1-hetzner-archive-1:
          ansible_host: 10.0.3.41
          data_volume_device: /dev/disk/by-id/scsi-0HC_Volume_1
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          bastion_private_ip: 10.0.3.5
    bastions:
      hosts:
        devnet-1-hetzner-bastion:
          # the entry bastion is reached directly on its public IP; ssh_config
          # has a direct Host block for it (no ProxyJump), so -F still applies
          ansible_host: 203.0.113.5
          public_ipv4: 203.0.113.5
          private_ip: 10.0.3.5
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          ssh_entry: true
          operator_ssh_cidrs:
            - 203.0.113.10/32
          nat_gateway: true
          remote_cidrs: []
    monitoring:
      hosts:
        devnet-1-hetzner-monitoring-1:
          ansible_host: 10.0.3.50
          data_volume_device: /dev/disk/by-id/scsi-0HC_Volume_2
          cloud: hetzner
          network_cidr: 10.0.3.0/24
          bastion_private_ip: 10.0.3.5
    cosigners:
      hosts:
