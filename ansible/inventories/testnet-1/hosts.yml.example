# This file is generated by `terraform apply` in terraform/envs/testnet-1
# (see outputs.tf's local_file.ansible_inventory) into hosts.yml — do not hand
# edit hosts.yml, it will be overwritten on the next apply. A matching
# ssh_config (ProxyJump through the bastions) is generated next to it. This
# .example shows the expected shape before any infrastructure exists, with
# the defaults: per-cloud bastions, monitoring on GCP, horcrux colocated (so
# `cosigners` is empty; with horcrux_mode = dedicated it holds c1..c3). The
# fleet is 10 validators (D7): v1-v5 Hetzner (.11-.15), v6-v10 GCP (.16-.20);
# one of each cloud is shown.
all:
  vars:
    ansible_user: deploy
    ansible_ssh_common_args: "-F {{ inventory_dir }}/ssh_config"
    chain_id: testnet-1
    fleet_cidrs:
      - 10.0.1.0/24
      - 10.0.2.0/24
    ssh_entry_bastion_private_ip: ""
    monitoring_host_private_ip: 10.0.2.50
    horcrux_mode: colocated
    wireguard_cidr: 10.0.9.0/24
    wireguard_port: 51820
  children:
    chain_nodes:
      children:
        validators:
        sentries:
        rpc:
        archive:
    validators:
      hosts:
        testnet-1-hetzner-validator-v1:
          ansible_host: 10.0.1.11
          moniker: testnet-1-hetzner-validator-v1
          cloud: hetzner
          network_cidr: 10.0.1.0/24
          bastion_private_ip: 10.0.1.5
        testnet-1-gcp-validator-v6:
          ansible_host: 10.0.2.16
          moniker: testnet-1-gcp-validator-v6
          cloud: gcp
          network_cidr: 10.0.2.0/24
          bastion_private_ip: 10.0.2.5
          local_ssd_count: 8
    sentries:
      hosts:
        testnet-1-hetzner-sentry-v1:
          ansible_host: 10.0.1.21
          public_ipv4: 203.0.113.21
          moniker: testnet-1-hetzner-sentry-v1
          cloud: hetzner
          network_cidr: 10.0.1.0/24
          bastion_private_ip: 10.0.1.5
        testnet-1-gcp-sentry-v6:
          ansible_host: 10.0.2.26
          public_ipv4: 198.51.100.26
          moniker: testnet-1-gcp-sentry-v6
          cloud: gcp
          network_cidr: 10.0.2.0/24
          bastion_private_ip: 10.0.2.5
    rpc:
      hosts:
        testnet-1-gcp-rpc-1:
          ansible_host: 10.0.2.31
          public_ipv4: 198.51.100.31
          cloud: gcp
          network_cidr: 10.0.2.0/24
          bastion_private_ip: 10.0.2.5
    archive:
      hosts:
        testnet-1-hetzner-archive-1:
          ansible_host: 10.0.1.41
          data_volume_device: /dev/disk/by-id/scsi-0HC_Volume_12345
          cloud: hetzner
          network_cidr: 10.0.1.0/24
          bastion_private_ip: 10.0.1.5
        testnet-1-gcp-archive-1:
          ansible_host: 10.0.2.42
          data_volume_device: /dev/disk/by-id/google-data
          cloud: gcp
          network_cidr: 10.0.2.0/24
          bastion_private_ip: 10.0.2.5
    bastions:
      hosts:
        testnet-1-hetzner-bastion:
          ansible_host: 203.0.113.5
          ansible_ssh_common_args: ""
          public_ipv4: 203.0.113.5
          private_ip: 10.0.1.5
          cloud: hetzner
          network_cidr: 10.0.1.0/24
          ssh_entry: true
          operator_ssh_cidrs:
            - 203.0.113.10/32
          nat_gateway: true
          wireguard_address: 10.0.9.1
          wireguard_peer: testnet-1-gcp-bastion
          wireguard_endpoint: 198.51.100.5
          remote_cidrs:
            - 10.0.2.0/24
        testnet-1-gcp-bastion:
          ansible_host: 198.51.100.5
          ansible_ssh_common_args: ""
          public_ipv4: 198.51.100.5
          private_ip: 10.0.2.5
          cloud: gcp
          network_cidr: 10.0.2.0/24
          ssh_entry: true
          operator_ssh_cidrs:
            - 203.0.113.10/32
          nat_gateway: false
          wireguard_address: 10.0.9.2
          wireguard_peer: testnet-1-hetzner-bastion
          wireguard_endpoint: 203.0.113.5
          remote_cidrs:
            - 10.0.1.0/24
    monitoring:
      hosts:
        testnet-1-gcp-monitoring-1:
          ansible_host: 10.0.2.50
          data_volume_device: /dev/disk/by-id/google-data
          cloud: gcp
          network_cidr: 10.0.2.0/24
          bastion_private_ip: 10.0.2.5
    cosigners:
      hosts:
