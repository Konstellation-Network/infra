# This file is generated by `terraform apply` in terraform/envs/testnet-1
# (see outputs.tf's local_file.ansible_inventory) into hosts.yml — do not hand
# edit hosts.yml, it will be overwritten on the next apply. This .example
# shows the expected shape before any infrastructure exists: 3 Hetzner
# validators/sentries + 1 archive, 2 GCP validators/sentries + 1 archive + 1 RPC.
all:
  vars:
    ansible_user: deploy
    chain_id: testnet-1
  children:
    validators:
      hosts:
        testnet-1-hetzner-validator-v1:
          ansible_host: 10.0.1.11
          moniker: testnet-1-hetzner-validator-v1
        testnet-1-gcp-validator-v4:
          ansible_host: 10.0.2.14
          moniker: testnet-1-gcp-validator-v4
          local_ssd_count: 8
    sentries:
      hosts:
        testnet-1-hetzner-sentry-v1:
          ansible_host: 203.0.113.21
          moniker: testnet-1-hetzner-sentry-v1
        testnet-1-gcp-sentry-v4:
          ansible_host: 198.51.100.24
          moniker: testnet-1-gcp-sentry-v4
    rpc:
      hosts:
        testnet-1-gcp-rpc-1:
          ansible_host: 198.51.100.31
    archive:
      hosts:
        testnet-1-hetzner-archive-1:
          ansible_host: 10.0.1.41
          data_volume_device: /dev/disk/by-id/scsi-0HC_Volume_12345
        testnet-1-gcp-archive-1:
          ansible_host: 10.0.2.42
          data_volume_device: /dev/disk/by-id/google-data
