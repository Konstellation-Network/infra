# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars — it's gitignored.
# hcloud_token is sensitive: prefer `export TF_VAR_hcloud_token=...` over putting it in this file at all.
# devnet-1 is Hetzner-only: no GCP project or credentials needed.

# Not testnet-1's key — one leaked deploy key should not reach two networks.
ssh_public_key = "ssh-ed25519 AAAA... deploy@devnet-1"

# Operator workstations / VPN egress allowed to SSH to the bastion. One /32
# per person. Never 0.0.0.0/0 (validated).
operator_ssh_cidrs = ["203.0.113.10/32"]

hetzner_ssh_key_ids = ["your-hcloud-ssh-key-id"]
# hetzner_location   = "fsn1"   # every devnet-1 host; must be in hetzner_network_zone
# sentry_count       = 1        # 2 keeps the rpc/archive fed through a sentry reboot

# Cost knobs (module defaults shown). The validator stays on a dedicated-vCPU
# local-NVMe type (ENGINEERING.md §9.2).
# validator_server_type = "ccx33"
# rpc_server_type       = "cpx41"

# The devnet explorer's Blockscout backend, once its route into the private
# network exists (README "Known gaps — Explorer reachability").
# explorer_cidrs = ["10.0.3.70/32"]
