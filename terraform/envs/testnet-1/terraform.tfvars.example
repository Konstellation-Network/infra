# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars — it's gitignored.
# hcloud_token is sensitive: prefer `export TF_VAR_hcloud_token=...` over putting it in this file at all.
# GCP credentials are NOT a tfvars entry — use `gcloud auth application-default login`
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key file.

ssh_public_key = "ssh-ed25519 AAAA... deploy@bootstrap"

# Operator workstations / VPN egress allowed to SSH to the bastion(s). One /32
# per person. Never 0.0.0.0/0 (validated).
operator_ssh_cidrs = ["203.0.113.10/32"]

# Topology decisions — defaults documented in variables.tf and README.md.
# bastion_ssh_entry = "per-cloud"   # or "hetzner" / "gcp": one internet-facing sshd
# monitoring_cloud  = "gcp"
# horcrux_mode      = "colocated"   # "dedicated" provisions cosigner_placement
# cosigner_placement = [
#   { cloud = "hetzner", location = "fsn1" },
#   { cloud = "gcp", zone = "us-central1-b" },
#   { cloud = "hetzner", location = "hel1" },
# ]

hetzner_ssh_key_ids = ["your-hcloud-ssh-key-id"]
hetzner_locations   = ["fsn1", "hel1", "nbg1"] # all in the subnet's network zone (eu-central); validated

gcp_project = "your-gcp-project-id"
gcp_region  = "us-central1"
gcp_zones   = ["us-central1-a", "us-central1-b", "us-central1-c"]
